{
  "name": "@jscad/array-utils",
  "version": "3.0.3-alpha.0",
  "description": "JSCAD Utility functions for arrays",
  "homepage": "https://openjscad.xyz/",
  "repository": "https://github.com/jscad/OpenJSCAD.org",
  "type": "module",
  "types": "src/index.d.ts",
  "main": "./src/index.js",
  "exports": {
    "node": "./src/index.js",
    "default": "./dist/jscad-array-utils.js"
  },
  "scripts": {
    "build": "rollup --config",
    "coverage": "c8 --all --reporter=html --reporter=text npm test",
    "test": "ava 'src/*.test.js' --verbose --timeout 2m",
    "test:tsd": "tsd",
    "version": "npm run build && git add dist"
  },
  "contributors": [
    {
      "name": "z3dev",
      "url": "https://github.com/z3dev"
    },
    {
      "name": "Mark 'kaosat-dev' Moissette",
      "url": "https://github.com/kaosat-dev"
    }
  ],
  "license": "MIT",
  "keywords": [
    "openjscad",
    "jscad",
    "utilities",
    "array"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "ava": "^8.0.0",
    "c8": "^12.0.0",
    "rollup": "^4.62.0"
  }
}
