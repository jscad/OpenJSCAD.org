    }
  ],
  "keywords": [
    "openjscad",
    "jscad",
    "export",
    "serializer",
    "obj"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@jscad/array-utils": "3.0.2-alpha.0",
    "@jscad/modeling": "3.0.4-alpha.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "ava": "^6.3.0",
    "c8": "^10.1.0",
    "rollup": "^4.52.0"
  },
  "gitHead": "a90b9bad95a417661c619dc733e62c587dc71a4a"
