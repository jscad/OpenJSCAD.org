    }
  ],
  "keywords": [
    "openjscad",
    "jscad",
    "export",
    "serializer",
    "json"
  ],
  "license": "MIT",
  "dependencies": {
    "@jscad/array-utils": "3.0.4-alpha.0",
    "@jscad/modeling": "3.0.7-alpha.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "ava": "^8.0.0",
    "c8": "^12.0.0",
    "rollup": "^4.62.0"
  },
  "gitHead": "a90b9bad95a417661c619dc733e62c587dc71a4a"
