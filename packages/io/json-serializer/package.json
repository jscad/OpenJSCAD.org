{
  "name": "@jscad/json-serializer",
  "version": "3.0.7-alpha.0",
  "description": "JSON Serializer for JSCAD",
  "homepage": "https://openjscad.xyz/",
  "repository": "https://github.com/jscad/OpenJSCAD.org",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    "node": "./src/index.js",
    "default": "./dist/jscad-json-serializer.js"
  },
  "scripts": {
    "build": "rollup --config",
    "coverage": "c8 --all --reporter=html --reporter=text npm test",
    "test": "ava 'tests/*.test.js' --verbose --timeout 2m",
    "version": "npm run build && git add dist"
  },
  "contributors": [
    {
      "name": "z3dev",
