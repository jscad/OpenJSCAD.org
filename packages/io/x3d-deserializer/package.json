{
  "name": "@jscad/x3d-deserializer",
  "version": "3.0.6-alpha.0",
  "description": "X3D Deserializer for JSCAD",
  "homepage": "https://openjscad.xyz/",
  "repository": "https://github.com/jscad/OpenJSCAD.org/",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    "default": "./dist/jscad-x3d-deserializer.js"
  },
  "scripts": {
    "build": "rollup --config",
    "coverage": "c8 --all --reporter=html --reporter=text npm test",
    "test": "ava --verbose --timeout 2m 'tests/**/*.test.js'",
    "version": "npm run build && git add dist"
  },
  "contributors": [
    {
      "name": "z3dev",
      "url": "https://github.com/z3dev"
    }
  ],
  "keywords": [
    "openjscad",
